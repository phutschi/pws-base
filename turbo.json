{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build", "^test"],
			"outputs": [".next/**", "!.next/cache/**"]
		},
		"check:types": {
			"dependsOn": ["^check:types"]
		},
		"check": {
			"dependsOn": ["^check"]
		},
		"check:unsafe": {
			"dependsOn": ["^check:unsafe"]
		},
		"check:write": {
			"dependsOn": ["^check:write"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"test": {
			"dependsOn": ["^test"]
		},
		"dev": {
			"persistent": true,
			"cache": false
		}
	}
}
