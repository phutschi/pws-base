```typescript
import type { NextPage } from "next";
import type { InferSelectModel } from "drizzle-orm";
import type { RouterOutputs } from "~/trpc/react";
```

## Common Utilities

```typescript
import { cn } from "@repo/ui/lib/utils";           // Tailwind merge
