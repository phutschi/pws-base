{
	"extends": "@repo/typescript-config/nextjs.json",
	"compilerOptions": {
		"declaration": false,
		"declarationMap": false,
		"baseUrl": ".",
		"paths": {
			"~/*": ["./src/*"],
			"@repo/ui/*": ["../../packages/ui/src/*"]
		},
		"plugins": [
			{
				"name": "next"
			}
		]
	},
	"include": [
		"next-env.d.ts",
		"next.config.js",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		"../../packages/ui/src/**/*.ts",
		"../../packages/ui/src/**/*.tsx"
	],
	"exclude": ["node_modules"]
}
